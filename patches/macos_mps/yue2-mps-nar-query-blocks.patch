+def _query_ranges(length, block, blocks_per_call):
+    # The short final block must keep its own SDPA dispatch.
+    full = length - length % block
+    stride = block * blocks_per_call
+    for start in range(0, full, stride):
+        yield start, min(start + stride, full)
+    if full < length:
+        yield full, length
 
 
